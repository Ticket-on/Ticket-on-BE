          },
          "expr": "tomcat_threads_config_max_threads",
          "legendFormat": "max",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(http_server_requests_active_seconds_gcount{uri=\"/v1/api/payments/confirm\"})",
          "legendFormat": "처리 중인 승인 요청",
          "refId": "C",
          "range": true
        }
