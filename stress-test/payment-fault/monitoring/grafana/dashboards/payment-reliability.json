    {
      "type": "timeseries",
      "id": 14,
      "title": "컨슈머 lag",
      "description": "쌓이기만 하면 컨슈머가 못 따라가는 중",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic=~\"payment.*|ticket.*\"})",
