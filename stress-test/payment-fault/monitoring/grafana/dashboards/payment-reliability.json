    {
      "type": "timeseries",
      "id": 11,
      "title": "DB 커넥션 풀 (Hikari)",
      "description": "pending > 0 이면 커넥션 대기 발생",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_active)",
          "legendFormat": "active",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_pending)",
          "legendFormat": "pending",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_max)",
          "legendFormat": "max",
